{
  "name": "wms-monorepo",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/build.js && node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "build:portal": "npm --workspace=apps/portal run build",
    "build:stockflow": "npm --workspace=apps/stockflow run build",
    "build:packing": "npm --workspace=apps/packing run build",
    "dev:packing": "npm --workspace=apps/packing run dev",
    "dev:stockflow": "npm --workspace=apps/stockflow run watch:css",
    "dev:portal": "npm --workspace=apps/portal run watch:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  }
}
